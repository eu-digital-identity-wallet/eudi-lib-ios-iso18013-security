ionRole"}]},"doc://MdocSecurity18013/documentation/MdocSecurity18013/SessionEncryption":{"abstract":[{"text":"Session encryption uses standard ephemeral key ECDH to establish session","type":"text"},{"text":" ","type":"text"},{"text":"keys for authenticated symmetric encryption.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/MdocSecurity18013\/documentation\/MdocSecurity18013\/SessionEncryption","isActive":true},{"text":" struct implements session encryption (for the mDoc currently)","type":"text"},{"text":" ","type":"text"},{"text":"It is initialized from a) the session establishment data received from the","type":"text"},{"text":" ","type":"text"},{"text":"mdoc reader, b) the device engagement data generated from the mdoc and c)","type":"text"},{"text":" ","type":"text"},{"text":"the handover data.","type":"text"},{"text":" ","type":"text"},{"text":"Copies share message counters and terminal state. Operations in each direction","type":"text"},{"text":" ","type":"text"},{"text":"must be sequential; overlap is rejected. A cryptographic failure or cancellation","type":"text"},{"text":" ","type":"text"},{"text":"terminates the session. Only a fresh device engagement may create a new session.","type":"text"}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"SessionEncryption","kind":"identifier"}],"identifier":"doc:\/\/MdocSecurity18013\/documentation\/MdocSecurity18013\/SessionEncryption","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SessionEncryption","kind":"identifier"}],"url":"\/documentation\/mdocsecurity18013\/sessionencryption","title":"SessionEncryption"},"doc://MdocSecurity18013/documentation/MdocSecurity18013":{"kind":"symbol","url":"\/documentation\/mdocsecurity18013","identifier":"doc:\/\/MdocSecurity18013\/documentation\/MdocSecurity18013","abstract":[],"type":"topic","title":"MdocSecurity18013","role":"collection"},"doc://Mdo